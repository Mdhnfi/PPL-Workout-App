# NextAuth Core Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=swinburne-diploma-schema-vcs-local-secret-2026

# Local Academic Demo Sign-In Fallback (allows testing RBAC roles on localhost before configuring Azure AD)
DEV_LOCAL_AUTH_ENABLED=true

# Microsoft Entra ID (Azure AD) App Registration
AZURE_AD_CLIENT_ID=your-entra-application-client-id
AZURE_AD_CLIENT_SECRET=your-entra-client-secret-value
AZURE_AD_TENANT_ID=your-entra-directory-tenant-id

# Optional comma-separated fallback emails granted ADMIN role if Azure App Roles are not assigned
BOOTSTRAP_ADMIN_EMAILS=student1@students.swinburne.edu.my

# GitHub Repository Integration (Fine-grained PAT with Contents: Read & Write)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
